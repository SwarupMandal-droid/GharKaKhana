[build]
builder = "nixpacks"

[deploy]
startCommand = "sh -c 'python manage.py collectstatic --noinput && python manage.py migrate && gunicorn config.wsgi:application --bind 0.0.0.0:$PORT --workers 2 --timeout 120'"

healthcheckPath = "/health/"

healthcheckTimeout = 100

restartPolicyType = "on_failure"

restartPolicyMaxRetries = 3