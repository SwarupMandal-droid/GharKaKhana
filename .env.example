# ─── Django Core ──────────────────────────────────────────────────────────────
SECRET_KEY=your-strong-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-railway-app.up.railway.app,yourdomain.com

# ─── Database (use DATABASE_URL on Railway — MySQL plugin auto-sets this) ─────
# Railway auto-injects DATABASE_URL — leave this blank on Railway.
# For local development, fill in the individual variables below instead.
DATABASE_URL=

# Local DB fallback (only used when DATABASE_URL is not set)
DB_NAME=gharkhana_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306

# ─── Cloudinary (media file storage) ─────────────────────────────────────────
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Razorpay (payments) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── Email (Gmail SMTP) ───────────────────────────────────────────────────────
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# ─── Platform ─────────────────────────────────────────────────────────────────
PLATFORM_UPI_ID=gharkhana@icici
PLATFORM_FEE_RATE=0.20
COOK_COMMISSION_RATE=5.00

# ─── Railway HTTPS ────────────────────────────────────────────────────────────
# Set this to your Railway-generated domain (without https://)
# e.g. gharkhana-production.up.railway.app
RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app

# Optional: comma-separated extra CSRF trusted origins
CSRF_TRUSTED_ORIGINS=
