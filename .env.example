# ─── Django Core ──────────────────────────────────────────────────────────────
SECRET_KEY=your-strong-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-railway-app.up.railway.app,yourdomain.com

# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Railway: add DATABASE_URL as an env variable pointing to Supabase
# Get this from: Supabase Dashboard → Settings → Database → Connection String (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ─── Supabase Storage (S3-compatible) ─────────────────────────────────────────
# Get these from: Supabase Dashboard → Storage → S3 Access Keys
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_S3_ACCESS_KEY_ID=your-s3-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
SUPABASE_STORAGE_BUCKET=media
# Use the region shown in your Supabase project settings (e.g. ap-south-1)
SUPABASE_S3_REGION=ap-south-1

# ─── Razorpay (payments) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── Email (Gmail SMTP) ───────────────────────────────────────────────────────
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# ─── Platform ─────────────────────────────────────────────────────────────────
PLATFORM_UPI_ID=gharkhana@icici
PLATFORM_FEE_RATE=0.20
COOK_COMMISSION_RATE=5.00

# ─── Railway HTTPS ────────────────────────────────────────────────────────────
# Set this to your Railway-generated domain (without https://)
# e.g. gharkhana-production.up.railway.app
RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app

# Optional: comma-separated extra CSRF trusted origins
CSRF_TRUSTED_ORIGINS=
